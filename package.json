{
  "name": "modest-deploy",
  "version": "0.1.0",
  "description": "Deploy small Node products to your own server: launch each with a command, deploy on every push that passes CI. No dependencies.",
  "license": "MIT",
  "author": "Modest Industries Ltd",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "modest-deploy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "deploy",
    "hosting",
    "systemd",
    "caddy",
    "webhook",
    "zero-dependency"
  ],
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npm run rules && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "rules": "node scripts/check-rules.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisismodest/modest-deploy.git"
  },
  "bugs": {
    "url": "https://github.com/thisismodest/modest-deploy/issues"
  },
  "homepage": "https://thisismodest.com/modest-deploy/"
}
